#!/usr/bin/env php
<?php

declare(strict_types=1);

// Same reasoning as bin/mcp-rector-warm: notices/warnings must never land on
// the JSON-RPC pipe on stdout.
ini_set('display_errors', 'stderr');

@ini_set('memory_limit', '-1');

// Dual-mode autoload: local clone vs. composer-global install.
foreach ([
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

use Dpt\McpRectorWarm\Lsp\LspLoop;
use Dpt\McpRectorWarm\Lsp\LspServer;
use Dpt\McpRectorWarm\Lsp\RectorDiagnosticsSource;
use Dpt\McpRectorWarm\Lsp\StdioLspTransport;
use Dpt\McpRectorWarm\RectorTool;
use Dpt\McpRectorWarm\Support\ProtocolStdoutIsolator;
use Dpt\McpRectorWarm\Support\ServerVersion;
use Dpt\McpRectorWarm\Support\WorkingDirectoryArgument;

// #194: same isolation as bin/mcp-rector-warm -- see ProtocolStdoutIsolator's
// own class docblock. A rule/project file writing straight to STDOUT during
// analysis must not corrupt the Content-Length-framed LSP stream either.
if (ProtocolStdoutIsolator::shouldIsolateHere()) {
    ProtocolStdoutIsolator::reexecIsolated(__FILE__, $argv);
}
$lspStdout = ProtocolStdoutIsolator::protocolStream();

// v1 (#52/#53): --working-dir is parsed here, same flag/behaviour as
// bin/mcp-rector-warm. --config is deliberately NOT parsed out here either,
// for the same reason bin/mcp-rector-warm leaves it alone: it stays in
// $_SERVER['argv'] untouched, and RectorConfigsResolver reads it from there
// directly when Rector boots inside RectorTool::process() below.
$workingDir = WorkingDirectoryArgument::parse($argv);

if ($workingDir !== null) {
    if (!is_dir($workingDir)) {
        fwrite(STDERR, "rector-warm-lsp: --working-dir not a directory: {$workingDir}\n");
        exit(2);
    }
    chdir($workingDir);
}

$transport = new StdioLspTransport(STDIN, $lspStdout);
$diagnostics = new RectorDiagnosticsSource(new RectorTool());

$server = new LspServer(
    ServerVersion::resolve(),
    $diagnostics,
    frameWriter: static function (array $frame) use ($transport): void {
        // Blocking finding 1: write the moment a frame is ready, not
        // batched until handle() returns -- this is what makes
        // window/workDoneProgress/create and the $/progress begin
        // notification reach the client BEFORE a slow cold-boot diagnose()
        // call, rather than after it.
        $transport->write($frame);
    },
    // PR #128 E2E review (blocking finding 2): $transport itself now owns
    // the read-ahead/push-back FIFO (StdioLspTransport::tryRead()/
    // pushBack()), so LspLoop's own read() calls -- which know nothing
    // about this mechanism -- see a pushed-back message exactly like any
    // other, with no separate queue to wire through here.
    tryReadAhead: static function (float $timeoutSeconds) use ($transport): ?array {
        return $transport->tryRead($timeoutSeconds);
    },
    pushBackMessage: static function (array $message) use ($transport): void {
        $transport->pushBack($message);
    },
);

// #106: the loop lives in LspLoop so the debounce (a read with a timeout)
// and the drain-before-publish ordering are unit-tested. PR #128's own
// $pending FIFO now lives inside StdioLspTransport itself (read()/
// waitForInput() both drain it first), so LspLoop's own read() calls see a
// pushed-back message exactly like any other -- nothing here needs to know
// about it.
exit((new LspLoop($transport, $server))->run());
