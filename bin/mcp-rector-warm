#!/usr/bin/env php
<?php

declare(strict_types=1);

// Every PHP-level notice/deprecation/warning display goes to stderr, never
// onto the JSON-RPC pipe on stdout (#15). This is PHP's own documented
// destination switch: no fd surgery, no risk of invalidating the STDOUT
// resource for whatever else in the process still legitimately expects it
// to be a live stream (closing and reopening fd 1 was tried and made a real
// container boot die silently, exit 255, nothing on stdout or stderr --
// something downstream still expects \STDOUT to be a valid, open resource).
ini_set('display_errors', 'stderr');

// Duplicate the real stdout descriptor up front, before anything else runs:
// handed explicitly to StdioTransport below, so the MCP transport keeps
// writing to the real pipe even if something later closes/reopens the
// STDOUT constant for its own reasons (the forked analysis child already
// does exactly that to its own copy of fd 1/2 -- see RectorRunner::runForked()).
$mcpStdout = @fopen('php://fd/1', 'wb') ?: STDOUT;

@ini_set('memory_limit', '-1');
// Dual-mode autoload: local clone vs. composer-global install.
foreach ([
    __DIR__ . '/../vendor/autoload.php',       // local dev: composer install in this repo
    __DIR__ . '/../../../autoload.php',         // composer global / project-local require
] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

use Dpt\McpRectorWarm\Support\ServerVersion;
use Mcp\Server;
use Mcp\Server\Transport\StdioTransport;

// Parse our own --working-dir flag BEFORE loading rector — keeps Server lean.
// --config is deliberately NOT parsed out here: RectorConfigsResolver reads it
// straight from $_SERVER['argv'] later, so it is left exactly where it is.
$workingDir = null;
foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--working-dir=')) {
        $workingDir = substr($arg, 14);
        break;
    }
}

if ($workingDir !== null) {
    if (!is_dir($workingDir)) {
        fwrite(STDERR, "mcp-rector-warm: --working-dir not a directory: {$workingDir}\n");
        exit(2);
    }
    chdir($workingDir);
}

// NOTE: rector's scoper-autoload is loaded lazily inside RectorRunner::boot() —
// not here — to avoid polluting the MCP SDK before the server starts.

$server = Server::builder()
    ->setServerInfo('mcp-rector-warm', ServerVersion::resolve())
    ->setDiscovery(dirname(__DIR__), ['src'])
    ->build();

$server->run(new StdioTransport(output: $mcpStdout));
