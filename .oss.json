{
  "repo": "Digital-Process-Tools/mcp-rector-warm",
  "default_branch": "main",
  "branch_pattern": "fix/{issue}",
  "test_command": "./vendor/bin/phpunit --no-coverage",
  "version_sites": [
    "CHANGELOG.md"
  ],
  "changelog_dir": "changelog.d",
  "changelog_untagged": [
    "0.3.0"
  ],
  "docs_targets": [
    "README.md",
    "docs/lsp-for-rector-maintainers.md"
  ],
  "labels": {
    "priority": ["priority-high", "priority-medium", "priority-low"],
    "lanes": ["lane-warm-state", "lane-protocol", "lane-tests"],
    "filed_by_loop": "filed-by-loop",
    "lane_other": "lane-other",
    "lane_patterns": {
      "lane-warm-state": [
        "src/RectorRunner.php",
        "src/RectorTool.php",
        "src/RectorCallTimeoutException.php",
        "src/RunnerInterface.php",
        "src/Support",
        "src/Warm",
        "bin/mcp-rector-warm",
        "bin/rector-cold-call.php",
        "bin/rector-warm-worker.php",
        "bin/rector-warm-orphan-watchdog.php",
        "tests/Unit/RectorRunner*.php",
        "tests/Unit/RectorTool*.php",
        "tests/Unit/ServerVersionTest.php",
        "tests/Integration"
      ],
      "lane-protocol": [
        "src/Lsp",
        "bin/rector-warm-lsp",
        "tests/Unit/Lsp",
        "tests/Unit/LspServerTest.php",
        "tests/Unit/StdioLspTransportTest.php",
        "tests/Fixtures/lsp-*",
        "tests/E2E/test_lsp_*.py",
        "tests/E2E/nvim"
      ],
      "lane-tests": [
        "tests/E2E/mcp_harness.py",
        "tests/E2E/stdio_tap.py",
        "tests/E2E/scenarios",
        "tests/E2E/test_scenarios.py",
        "tests/E2E/test_mcp_client.py",
        "tests/E2E/test_process_descendants_windows.py",
        "tests/E2E/test_warm_vs_cold_tool.py",
        "tests/E2E/run.sh",
        "tests/E2E/pytest.ini",
        "tests/E2E/requirements.txt",
        "tests/Fixtures/project",
        "tests/Unit/TrapDNoHostPathsTest.php",
        "tools",
        ".github/workflows"
      ]
    }
  },
  "milestones": [],
  "_milestones_note": "Declined, not merely absent: this repo does not use GitHub milestones. Recorded so a triage sweep reads this note instead of re-flagging the empty list as a fresh finding.",
  "release": {
    "tag_pattern": "v{version}",
    "authority": "loop",
    "merge_method": "squash",
    "create_release": true,
    "draft": false,
    "latest": true,
    "commit_subject": null,
    "triggers": {
      "merged_prs": 10,
      "soak_hours": 48
    }
  },
  "curate_route_threshold": 15,
  "triage_route_threshold": 0,
  "test_measurement_configured": true
}
