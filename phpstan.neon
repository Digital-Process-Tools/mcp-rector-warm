parameters:
    level: 8
    paths:
        - src
        - bin
        - tests
    excludePaths:
        - tests/Fixtures/*
    # Quoted so the file also parses as YAML: the README badge reads `level` from it.
    tmpDir: '%currentWorkingDirectory%/.phpstan-cache'
    ignoreErrors:
        # #185: SessionHooks deliberately reaches into PHPStan's (and
        # BetterReflection's) internal, non-BC-covered API to reuse the exact
        # services Rector's own analysis needs for a warm session -- see the
        # class docblock. These calls are the point of the file, not a bug to
        # fix, and no public API covers them.
        -
            identifier: phpstanApi.class
            path: src/Warm/SessionHooks.php
        -
            identifier: phpstanApi.classConstant
            path: src/Warm/SessionHooks.php
        -
            identifier: phpstanApi.method
            path: src/Warm/SessionHooks.php
        # #268: SessionHooksTest reaches the same non-BC-covered PHPStan/BetterReflection
        # API as SessionHooks.php itself (see above) to build fakes of the real,
        # final/interface types SessionHooks consumes -- the whole point of these tests,
        # not a bug to fix. FakeContainer's getByType() has its own narrow
        # @phpstan-ignore return.type comment at the one call site, not a file-wide
        # entry here: a file-wide one would hide an unrelated return-type mistake
        # anywhere else in this file too.
        -
            identifier: phpstanApi.classConstant
            path: tests/Unit/Warm/SessionHooksTest.php
        -
            identifier: phpstanApi.interface
            path: tests/Unit/Warm/SessionHooksTest.php
